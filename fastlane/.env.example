# 복사해서 fastlane/.env 로 쓰세요. .env 는 절대 커밋하지 않습니다.

# match 복호화 비밀번호 (팀 비밀번호 관리자에서 받기) — 팀원도 필요
MATCH_PASSWORD=

# --- 아래는 관리자(Account Holder)만 필요 ---
# App Store Connect > 사용자 및 액세스 > 통합 > App Store Connect API
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXX.p8
